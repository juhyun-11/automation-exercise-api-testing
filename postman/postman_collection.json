              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"HTTP status is 200\", function(){\n    pm.expect(pm.response.code).to.eql(200);\n});\npm.test(\"Business responseCode is 200\", function(){\n    pm.expect(body.responseCode).to.eql(200);\n});\npm.test(\"Login message is correct\",function(){\n    pm.expect(body.message).to.eql(\"User exists!\")\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
